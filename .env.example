# 复制为 .env 或在 shell 中 export；不要提交真实 cookie/token
SAU_WORKDIR=/path/to/social-auto-upload
SAU_BIN=/path/to/social-auto-upload/.venv/bin/sau
SAU_ACCOUNT_XHS=xhs-account
SAU_ACCOUNT_DOUYIN=douyin-account
SAU_ACCOUNT_KUAISHOU=kuaishou-account
SAU_ACCOUNT_TENCENT=tencent-account
SAU_ACCOUNT_BILIBILI=bilibili-account
